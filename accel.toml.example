# Copy to accel.toml (gitignored). Environment variables override these values.
[azure_openai]
# Set AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_API_KEY in your environment or a
# gitignored .env file (see ADR-0008). Never put the API key here.
deployment = "gpt-6.1-sol"     # overridden by AZURE_OPENAI_DEPLOYMENT_NAME
api_version = "2024-10-21"     # overridden by OPENAI_API_VERSION
# Prices in USD per million tokens. Set both to enforce cost budgets.
# input_usd_per_mtok = 0.0
# output_usd_per_mtok = 0.0

[accel]
home = "~/.accel"
# registry = "https://github.com/YOUR-ORG/accel-registry.git"
# mirror = "https://YOUR-INTERNAL-MIRROR"
# eval_credit_budget = 1000
