{
  "$defs": {
    "RubricItem": {
      "additionalProperties": false,
      "description": "One graded criterion and its share of the score.",
      "properties": {
        "criterion": {
          "minLength": 1,
          "title": "Criterion",
          "type": "string"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "criterion",
        "weight"
      ],
      "title": "RubricItem",
      "type": "object"
    }
  },
  "$id": "eval-case.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`skills/<name>/evals/<n>.yaml`: one prompt and its rubric.",
  "properties": {
    "fixture": {
      "description": "Repo state the eval starts from",
      "minLength": 1,
      "title": "Fixture",
      "type": "string"
    },
    "id": {
      "description": "<skill>-<nn>",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-\\d{2,}$",
      "title": "Id",
      "type": "string"
    },
    "prompt": {
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "rubric": {
      "items": {
        "$ref": "#/$defs/RubricItem"
      },
      "minItems": 1,
      "title": "Rubric",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "description": "Contract version; bump on breaking changes.",
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "prompt",
    "fixture",
    "rubric"
  ],
  "title": "EvalCase",
  "type": "object"
}
