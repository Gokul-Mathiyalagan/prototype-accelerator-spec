[importlinter]
root_packages =
    accel_core
    accel_extract
    accel_skills
    accel_package
    accel_design
    accel_sdlc
    accel_evals
    accel_mcp
    accel_cli

[importlinter:contract:core]
name = core imports only its declared internal dependencies
type = forbidden
source_modules =
    accel_core
forbidden_modules =
    accel_extract
    accel_skills
    accel_package
    accel_design
    accel_sdlc
    accel_evals
    accel_mcp
    accel_cli
allow_indirect_imports = True

